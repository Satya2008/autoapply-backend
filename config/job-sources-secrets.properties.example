# Copy to job-sources-secrets.properties (same folder) and fill in. That file is not committed.
# A job source reads a value with ${setting:<key>}, e.g. query parameter app_id = ${setting:adzuna-app-id}.
# job-service reads this file at start, so restart it after a change.

# Adzuna (https://developer.adzuna.com): free app id and key
naukriradar.settings.adzuna-app-id=
naukriradar.settings.adzuna-app-key=

# RapidAPI (https://rapidapi.com): one key for every RapidAPI job source. Subscribe (free plan)
# to JSearch, LinkedIn Job Search API and Active Jobs DB with the same account.
naukriradar.settings.rapidapi-key=

# Jooble (https://jooble.org/api/about): free key, sent in the URL path
naukriradar.settings.jooble-key=
